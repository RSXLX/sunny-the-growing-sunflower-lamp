# No cloud keys are required for local parameterized demo mode.
HOST=127.0.0.1
PORT=8787
DEMO_MODE=1
# Use a private, trusted LAN only for hardware HTTP commissioning.
ALLOW_LAN=0
TRIPO_API_KEY=
TRIPO_API_BASE=https://openapi.tripo3d.ai/v3
TRIPO_MODEL_VERSION=v3.1-20260211
TRIPO_POLL_SECONDS=8
# Lifetime task reservations in this local database, shared across local accounts.
# Zero disables new paid tasks. Raise deliberately; this is NOT a money/credit cap.
# Failed/uncertain tasks keep their reservation to prevent accidental paid retries.
TRIPO_MAX_SUBMISSIONS=0
# Enable real generation only after accepting possible API charges in the UI.
# Each generated asset remains "needs_review" until manually checked.
COOKIE_SECURE=0
